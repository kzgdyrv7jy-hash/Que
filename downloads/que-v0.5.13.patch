+@Composable
+private fun QueGuideMeta(text: String) {
+    Text(
+        text = text,
+        color = Color.White,
+        fontSize = 16.sp,
+        lineHeight = 20.sp,
+        fontWeight = FontWeight.SemiBold,
+        maxLines = 1,
+        overflow = TextOverflow.Ellipsis,
+    )
+}
